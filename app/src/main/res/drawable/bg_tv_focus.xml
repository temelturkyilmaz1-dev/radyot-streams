<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF174A78" />
            <stroke android:width="4dp" android:color="#FF35D9FF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF0E5F91" />
            <stroke android:width="3dp" android:color="#FFFFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF151A22" />
            <stroke android:width="1dp" android:color="#FF4E5968" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
