<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF174A78" />
            <stroke android:width="5dp" android:color="#FF35D9FF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF35D9FF" />
            <stroke android:width="3dp" android:color="#FFFFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#FF087F5B"
                android:endColor="#FF0E789A" />
            <stroke android:width="4dp" android:color="#FF7CFFB2" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F02B3B50" />
            <stroke android:width="2dp" android:color="#FF8194AD" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
