<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tvRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF1D2B3D">

    <ImageView
        android:id="@+id/tvBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.40"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/radyot_logo" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_tv_screen_overlay" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="38dp"
        android:paddingTop="28dp"
        android:paddingEnd="38dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/tvBrandLogo"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:contentDescription="RadiOnline"
                android:scaleType="fitCenter"
                android:src="@drawable/radyot_logo" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="430dp"
                android:layout_height="58dp"
                android:background="@drawable/bg_tv_search_box"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="3dp">

                <LinearLayout
                    android:id="@+id/tvSearch"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tv_search_action"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:nextFocusDown="@id/tvRadioList"
                    android:nextFocusRight="@id/tvVoiceSearch"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_search"
                        android:tint="#FFE8EDF3" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:text="Radyo ara"
                        android:textColor="#FFE8EDF3"
                        android:textSize="20sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/tvVoiceSearch"
                    android:layout_width="64dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_tv_search_action"
                    android:contentDescription="Sesli radyo arama"
                    android:focusable="true"
                    android:nextFocusDown="@id/tvRadioList"
                    android:nextFocusLeft="@id/tvSearch"
                    android:nextFocusRight="@id/tvAll"
                    android:padding="14dp"
                    android:src="@drawable/ic_mic"
                    android:tint="#FFE8EDF3" />
            </LinearLayout>

            <Button
                android:id="@+id/tvAll"
                android:layout_width="wrap_content"
                android:layout_height="54dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_tv_top_menu_focus"
                android:focusable="true"
                android:nextFocusDown="@id/tvPlayPause"
                android:nextFocusLeft="@id/tvVoiceSearch"
                android:nextFocusRight="@id/tvFavorites"
                android:paddingHorizontal="24dp"
                android:text="Tüm Radyolar"
                android:textColor="@color/tv_top_menu_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/tvFavorites"
                android:layout_width="wrap_content"
                android:layout_height="54dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_tv_top_menu_focus"
                android:focusable="true"
                android:nextFocusDown="@id/tvPlayPause"
                android:nextFocusLeft="@id/tvAll"
                android:nextFocusRight="@id/tvSettings"
                android:paddingHorizontal="24dp"
                android:text="Favoriler"
                android:textColor="@color/tv_top_menu_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/tvSettings"
                android:layout_width="wrap_content"
                android:layout_height="54dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_tv_top_menu_focus"
                android:focusable="true"
                android:nextFocusDown="@id/tvPlayPause"
                android:nextFocusLeft="@id/tvFavorites"
                android:paddingHorizontal="24dp"
                android:text="Ayarlar"
                android:textColor="@color/tv_top_menu_text"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="26dp"
            android:paddingEnd="26dp">

            <ImageView
                android:id="@+id/tvArtwork"
                android:layout_width="270dp"
                android:layout_height="270dp"
                android:background="@drawable/bg_tv_focus"
                android:contentDescription="@string/radio_logo"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/radyot_logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="42dp"
                android:layout_weight="1"
                android:gravity="start"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvStationName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:maxLines="2"
                        android:text="RadiOnline"
                        android:textColor="#FFFFFFFF"
                        android:textSize="38sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/tvCountryBlock"
                        android:layout_width="64dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/tvCountryFlag"
                            android:layout_width="64dp"
                            android:layout_height="40dp"
                            android:contentDescription="İstasyon ülkesi"
                            android:scaleType="centerCrop" />

                        <TextView
                            android:id="@+id/tvStationCity"
                            android:layout_width="64dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:maxLines="1"
                            android:textColor="#FFD5DCE6"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvMetadata"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:maxLines="3"
                    android:textColor="#FFD5DCE6"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="#FF35D9FF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvConnectionQuality"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#FFB8C3D1"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/tvPrevious"
                        style="@style/Widget.RadyoT.RoundButton"
                        android:layout_marginEnd="14dp"
                        android:background="@drawable/bg_tv_focus"
                        android:contentDescription="Önceki radyo"
                        android:focusable="true"
                        android:nextFocusDown="@id/tvRadioList"
                        android:nextFocusRight="@id/tvPlayPause"
                        android:nextFocusUp="@id/tvAll"
                        android:src="@drawable/ic_previous" />

                    <ImageButton
                        android:id="@+id/tvPlayPause"
                        style="@style/Widget.RadyoT.RoundButton"
                        android:layout_marginEnd="14dp"
                        android:background="@drawable/bg_tv_focus"
                        android:contentDescription="Oynat veya duraklat"
                        android:focusable="true"
                        android:nextFocusDown="@id/tvRadioList"
                        android:nextFocusLeft="@id/tvPrevious"
                        android:nextFocusRight="@id/tvNext"
                        android:nextFocusUp="@id/tvAll"
                        android:src="@drawable/ic_play" />

                    <ImageButton
                        android:id="@+id/tvNext"
                        style="@style/Widget.RadyoT.RoundButton"
                        android:background="@drawable/bg_tv_focus"
                        android:contentDescription="Sonraki radyo"
                        android:focusable="true"
                        android:nextFocusDown="@id/tvRadioList"
                        android:nextFocusLeft="@id/tvPlayPause"
                        android:nextFocusUp="@id/tvAll"
                        android:src="@drawable/ic_next" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginBottom="6dp"
            android:text="Kısa bas: Aç   •   Basılı tut: Favori"
            android:textColor="#FFB8C3D1"
            android:textSize="13sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/tvRadioList"
            android:layout_width="match_parent"
            android:layout_height="132dp"
            android:clipToPadding="false"
            android:descendantFocusability="afterDescendants"
            android:focusable="true"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:scrollbars="horizontal" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tvAmbientOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F20B111A"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="54dp"
        android:visibility="gone">

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="HH:mm"
            android:format24Hour="HH:mm"
            android:textColor="#FFFFFFFF"
            android:textSize="34sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/tvAmbientLogo"
            android:layout_width="310dp"
            android:layout_height="310dp"
            android:layout_marginTop="20dp"
            android:contentDescription="@string/radio_logo"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/tvAmbientName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="#FFFFFFFF"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAmbientTrack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="#FFD5DCE6"
            android:textSize="21sp" />

        <TextView
            android:id="@+id/tvAmbientDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#FFE53935"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
