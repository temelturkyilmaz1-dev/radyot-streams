<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appScreenBackground">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/playerBottomGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.55" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/playerCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardCornerRadius="0dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toTopOf="@id/playerBottomGuide"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeWidth="0dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/imgLogoBackground"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/radyot_logo" />

            <View
                android:id="@+id/viewBackgroundShade"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#000000" />

            <LinearLayout
                android:id="@+id/playerLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="8dp">

                <FrameLayout
                    android:id="@+id/artworkContainer"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:padding="1dp">

                    <ImageView
                        android:id="@+id/imgArtwork"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:contentDescription="@string/album_art"
                        android:scaleType="fitCenter"
                        android:src="@drawable/radyot_logo" />

                    <ImageView
                        android:id="@+id/imgStationLogo"
                        android:layout_width="1dp"
                        android:layout_height="1dp"
                        android:visibility="gone"
                        android:contentDescription="@string/radio_logo" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/stationInfoPanel"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="4dp"
                        android:visibility="gone"
                        app:cardBackgroundColor="?attr/colorSurfaceContainer"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="8dp"
                        app:strokeColor="?attr/colorOutlineVariant"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:paddingStart="16dp"
                            android:paddingTop="12dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="10dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:id="@+id/imgInfoStationLogo"
                                    android:layout_width="52dp"
                                    android:layout_height="52dp"
                                    android:background="@drawable/bg_station_logo"
                                    android:contentDescription="@string/radio_logo"
                                    android:padding="1dp"
                                    android:scaleType="fitCenter" />

                                <TextView
                                    android:id="@+id/txtInfoStationName"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="10dp"
                                    android:layout_weight="1"
                                    android:ellipsize="end"
                                    android:maxLines="2"
                                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/txtInfoContent"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

                            <LinearLayout
                                android:id="@+id/infoLocationRow"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/txtInfoLocation"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:maxLines="1"
                                    android:textAppearance="@style/TextAppearance.Material3.BodySmall" />

                                <ImageView
                                    android:id="@+id/imgInfoCountryFlag"
                                    android:layout_width="20dp"
                                    android:layout_height="14dp"
                                    android:layout_marginStart="5dp"
                                    android:contentDescription="@null"
                                    android:scaleType="fitXY"
                                    android:visibility="gone" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/txtInfoDetails"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:textAppearance="@style/TextAppearance.Material3.BodySmall" />

                            <TextView
                                android:id="@+id/txtInfoWebsite"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:ellipsize="middle"
                                android:maxLines="1"
                                android:textAppearance="@style/TextAppearance.Material3.BodySmall" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1"
                                android:gravity="bottom|end"
                                android:orientation="horizontal">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnInfoWebsite"
                                    style="@style/Widget.Material3.Button.TextButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="40dp"
                                    android:minHeight="0dp"
                                    android:text="@string/open_website" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnInfoShare"
                                    style="@style/Widget.Material3.Button.TextButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="40dp"
                                    android:minHeight="0dp"
                                    android:text="@string/share_station" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </FrameLayout>

                <LinearLayout
                    android:id="@+id/playerControlsColumn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">

                <TextView
                    android:id="@+id/txtSong"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/waiting_song_info"
                    android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtRadioName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/no_radio_selected"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <com.radyo.turkiyeradyolari.PlayingEqualizerView
                        android:id="@+id/playerEqualizer"
                        android:layout_width="28dp"
                        android:layout_height="12dp" />

                    <TextView
                        android:id="@+id/txtStreamQuality"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:ellipsize="marquee"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:maxWidth="210dp"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btnPrevious"
                        style="@style/Widget.RadyoT.RoundButton"
                        android:contentDescription="@string/previous_station"
                        android:src="@drawable/ic_previous" />

                    <ImageButton
                        android:id="@+id/btnPlayPause"
                        style="@style/Widget.RadyoT.PrimaryRoundButton"
                        android:layout_marginHorizontal="14dp"
                        android:contentDescription="@string/play_pause"
                        android:src="@drawable/ic_play" />

                    <ImageButton
                        android:id="@+id/btnNext"
                        style="@style/Widget.RadyoT.RoundButton"
                        android:contentDescription="@string/next_station"
                        android:src="@drawable/ic_next" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <androidx.mediarouter.app.MediaRouteButton
                        android:id="@+id/btnCast"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_top_action_button"
                        android:contentDescription="@string/cast_to_device"
                        android:padding="8dp" />

                    <ImageButton
                        android:id="@+id/btnMute"
                        style="@style/Widget.RadyoT.IconButton"
                        android:contentDescription="@string/mute"
                        android:src="@drawable/ic_volume_mute" />

                    <SeekBar
                        android:id="@+id/seekVolume"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minWidth="96dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/txtVolumePercent"
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="6dp"
                        android:gravity="end"
                        android:text="0%" />

                    <ImageButton
                        android:id="@+id/btnExit"
                        style="@style/Widget.RadyoT.IconButton"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_exit_button"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:contentDescription="@string/exit_app"
                        android:src="@drawable/ic_exit"
                        android:tint="#FFE05252" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/quickActionsBar"
                    android:layout_width="272dp"
                    android:layout_height="56dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_player_quick_actions"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btnPlayerHistory"
                        style="@style/Widget.RadyoT.IconButton"
                        android:layout_marginHorizontal="6dp"
                        android:contentDescription="@string/show_recent_tracks"
                        android:src="@drawable/ic_history" />

                    <ImageButton
                        android:id="@+id/btnPlayerTimer"
                        style="@style/Widget.RadyoT.IconButton"
                        android:layout_marginHorizontal="6dp"
                        android:contentDescription="@string/timer"
                        android:src="@drawable/ic_sleep_timer" />

                    <ImageButton
                        android:id="@+id/btnPlayerFavorite"
                        style="@style/Widget.RadyoT.IconButton"
                        android:layout_marginHorizontal="6dp"
                        android:contentDescription="@string/add_to_favorites"
                        android:src="@drawable/ic_favorite" />

                    <ImageButton
                        android:id="@+id/btnPlayerShare"
                        style="@style/Widget.RadyoT.IconButton"
                        android:layout_marginHorizontal="6dp"
                        android:contentDescription="@string/share_station"
                        android:src="@drawable/ic_share" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <View
                        android:layout_width="68dp"
                        android:layout_height="68dp"
                        android:layout_gravity="center"
                        android:alpha="0.94"
                        android:background="@drawable/bg_radyot_logo_ambient" />

                    <ImageView
                        android:id="@+id/imgTopLogo"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/app_name"
                        android:scaleType="fitCenter"
                        android:src="@drawable/radyot_logo" />
                </FrameLayout>
                </LinearLayout>
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnStationInfo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="top|start"
                android:layout_margin="14dp"
                android:background="@drawable/bg_top_action_button"
                android:contentDescription="@string/station_info"
                android:padding="8dp"
                android:src="@drawable/ic_info" />

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="top|end"
                android:layout_margin="14dp"
                android:background="@drawable/bg_top_action_button"
                android:contentDescription="@string/settings"
                android:padding="8dp"
                android:src="@drawable/ic_settings" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnHistoryToggle"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="4dp"
        android:maxLines="1"
        android:text="@string/show_recent_tracks"
        android:textSize="12sp"
        app:layout_constraintEnd_toStartOf="@id/btnFavorites"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/playerBottomGuide" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnFavorites"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="4dp"
        android:maxLines="1"
        android:text="@string/favorites"
        android:textSize="12sp"
        app:layout_constraintEnd_toStartOf="@id/btnAllRadios"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/btnHistoryToggle"
        app:layout_constraintTop_toBottomOf="@id/playerBottomGuide" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAllRadios"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        android:maxLines="1"
        android:text="@string/all_radios"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/btnFavorites"
        app:layout_constraintTop_toBottomOf="@id/playerBottomGuide" />

    <TextView
        android:id="@+id/txtRecentStationsTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="4dp"
        android:text="@string/recent_stations"
        android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnHistoryToggle" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerRecentStations"
        android:layout_width="0dp"
        android:layout_height="62dp"
        android:layout_marginHorizontal="8dp"
        android:clipToPadding="false"
        android:paddingHorizontal="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtRecentStationsTitle" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/historyOverlayCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:saveEnabled="false"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:visibility="gone"
        app:cardCornerRadius="20dp"
        app:cardElevation="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnHistoryToggle"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/txtHistoryOverlayTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/show_recent_tracks"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtHistoryOverlayEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@string/no_song_history" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerHistoryOverlay"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingVertical="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHistoryOverlayAll"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/show_all_history" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
