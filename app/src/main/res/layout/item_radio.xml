<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/radioCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="6dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp">

        <LinearLayout
            android:layout_width="54dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgLogo"
                android:background="@drawable/bg_station_logo"
                android:padding="1dp"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:contentDescription="@string/radio_logo"
                android:scaleType="fitCenter" />

            <com.radyo.turkiyeradyolari.PlayingEqualizerView
                android:id="@+id/playingEqualizer"
                android:layout_width="28dp"
                android:layout_height="8dp"
                android:layout_marginTop="1dp"
                android:visibility="invisible" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtRadioName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:maxLines="1"
            android:singleLine="true"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnFavorite"
            style="@style/Widget.RadyoT.IconButton"
            android:contentDescription="@string/favorite"
            android:src="@drawable/ic_favorite" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
