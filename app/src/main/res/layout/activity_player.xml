<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <Button
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="← Geri" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imgPlayerLogo"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_marginTop="20dp"
            android:src="@mipmap/ic_launcher" />
        <TextView
            android:id="@+id/txtArtist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="👤 Sanatçı bilgisi bekleniyor..."
            android:textSize="16sp" />

        <TextView
            android:id="@+id/txtSongTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="🎵 Şarkı bilgisi bekleniyor..."
            android:textSize="16sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/txtPlayerRadio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="TRT FM"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtPlayerStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Yayın durduruldu"
            android:textSize="16sp" />

        <Space
            android:layout_width="1dp"
            android:layout_height="40dp" />

        <Button
            android:id="@+id/btnPlayerPlay"
            android:layout_width="260dp"
            android:layout_height="60dp"
            android:text="▶ Oynat"
            android:textSize="20sp" />

    </LinearLayout>

</LinearLayout>