<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widgetRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#E6222222" android:gravity="center_vertical" android:orientation="horizontal" android:padding="10dp">
    <ImageView android:id="@+id/widgetArtwork" android:layout_width="64dp" android:layout_height="64dp" android:contentDescription="@string/album_art" android:scaleType="centerInside" />
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:orientation="vertical" android:paddingStart="10dp" android:paddingEnd="6dp">
        <TextView android:id="@+id/widgetStation" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="#FFFFFFFF" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:id="@+id/widgetTrack" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="#CCFFFFFF" android:textSize="12sp" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="36dp" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageButton android:id="@+id/widgetPrevious" android:layout_width="40dp" android:layout_height="36dp" android:background="@android:color/transparent" android:contentDescription="@string/previous_station" android:src="@drawable/ic_previous" android:tint="#FFFFFFFF" />
            <ImageButton android:id="@+id/widgetPlayPause" android:layout_width="40dp" android:layout_height="36dp" android:background="@android:color/transparent" android:contentDescription="@string/play_pause" android:src="@drawable/ic_play" android:tint="#FFFFFFFF" />
            <ImageButton android:id="@+id/widgetNext" android:layout_width="40dp" android:layout_height="36dp" android:background="@android:color/transparent" android:contentDescription="@string/next_station" android:src="@drawable/ic_next" android:tint="#FFFFFFFF" />
        </LinearLayout>
    </LinearLayout>
    <ImageButton android:id="@+id/widgetFavorite" android:layout_width="44dp" android:layout_height="match_parent" android:background="@android:color/transparent" android:contentDescription="@string/favorite" android:src="@drawable/ic_favorite" android:tint="#FFFFFFFF" />
</LinearLayout>
