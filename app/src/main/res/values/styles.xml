<resources>
    <style name="Widget.RadyoT.IconButton" parent="">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:tint">?attr/colorOnSurface</item>
        <item name="android:padding">12dp</item>
    </style>
    <style name="Widget.RadyoT.LargeIconButton" parent="">
        <item name="android:layout_width">72dp</item>
        <item name="android:layout_height">72dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:tint">?attr/colorOnSurface</item>
        <item name="android:padding">10dp</item>
    </style>
    <style name="Widget.RadyoT.RoundButton" parent="">
        <item name="android:layout_width">58dp</item>
        <item name="android:layout_height">58dp</item>
        <item name="android:background">@drawable/bg_round_tonal</item>
        <item name="android:tint">?attr/colorOnSurface</item>
        <item name="android:padding">16dp</item>
    </style>
    <style name="Widget.RadyoT.PrimaryRoundButton" parent="">
        <item name="android:layout_width">70dp</item>
        <item name="android:layout_height">70dp</item>
        <item name="android:background">@drawable/bg_round_primary</item>
        <item name="android:tint">@android:color/white</item>
        <item name="android:padding">20dp</item>
    </style>
    <style name="Widget.RadyoT.ColorButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_margin">5dp</item>
        <item name="cornerRadius">22dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:text"></item>
        <item name="strokeWidth">0dp</item>
    </style>
</resources>
