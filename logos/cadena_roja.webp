<!doctype html>
<!-- Cadena Roja - versión lista para Oracle / Nginx -->
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#09090b">
<meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
<meta http-equiv="Pragma" content="no-cache">
<meta http-equiv="Expires" content="0">
<title>Cadena Roja — En vivo</title>
<link rel="icon" href="data:image/webp;base64,">
<style>
:root{--bg:#08090b;--panel:#111215;--panel2:#17181c;--line:#2b2c31;--red:#ef143a;--red2:#ff3156;--text:#fff;--muted:#a7a8ae;--green:#1ed760}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:#08090b;color:#fff;font-family:Inter,Segoe UI,Arial,sans-serif;padding-bottom:76px}a{color:inherit;text-decoration:none}button,input{font:inherit}
.header{height:64px;display:flex;align-items:center;gap:18px;padding:0 2vw;position:sticky;top:0;z-index:50;background:#07080aee;border-bottom:2px solid #35121b;backdrop-filter:blur(16px)}
.brand{display:flex;align-items:center;gap:10px;min-width:150px}.brand img{width:54px;height:54px;border-radius:6px;object-fit:cover}.brand span{font-weight:900;font-size:14px}
.nav{display:flex;align-items:center;gap:19px;white-space:nowrap;overflow:auto;font-size:13px;font-weight:700}.nav a{padding:23px 0 17px;color:#e7e7e9;border-bottom:3px solid transparent}.nav a.active,.nav a:hover{color:#ff284d;border-color:#ff284d}
.searchIcon{margin-left:auto;font-size:21px}
.liveHero{display:grid;grid-template-columns:minmax(0,1.55fr) 360px;min-height:390px;border-bottom:2px solid #7a101f;background:radial-gradient(circle at 33% 36%,#6d1122 0,transparent 33%),linear-gradient(100deg,#101114,#19090c 67%,#101114)}
.heroMain{position:relative;overflow:hidden;display:grid;grid-template-columns:36% 1fr;align-items:end;padding:18px 24px 0}
.artistPortrait{height:100%;min-height:370px;display:flex;align-items:end;justify-content:center;position:relative}
.artistPortrait:after{content:"";position:absolute;inset:0;background:linear-gradient(0deg,#0b0b0d 0,transparent 45%),radial-gradient(circle at 50% 50%,#ed15352e,transparent 64%)}
.artistPortrait img{width:100%;height:100%;object-fit:cover;object-position:center top;filter:saturate(.95) contrast(1.04)}
.liveBadge{position:absolute;left:18px;top:32px;z-index:3;background:#ff123e;border:2px solid #ff4464;border-radius:24px;padding:15px 20px;font-weight:900;box-shadow:0 0 25px #ff153955}
.nowBox{padding:38px 22px 22px;z-index:2}
.nowLabel{display:inline-block;background:#e81338;border-radius:5px;padding:6px 10px;font-weight:900;font-size:13px;letter-spacing:.4px}
.nowBox h1{font-size:42px;margin:9px 0 0;line-height:1}.nowBox .song{font-size:27px;margin:4px 0 12px;color:#f1f1f2}.wave{height:54px;display:flex;align-items:end;gap:3px;margin:8px 0 10px}.wave i{width:4px;border-radius:2px;background:linear-gradient(#ff7990,#f0163e)}.progress{height:5px;background:#36363b;border-radius:20px;position:relative}.progress b{display:block;height:100%;width:0;background:#ff1642;border-radius:20px}.times{display:flex;justify-content:space-between;color:#c1c1c6;font-size:12px;margin-top:6px}
.controls{display:flex;align-items:center;gap:18px;margin-top:10px}.round{width:50px;height:50px;border:0;border-radius:50%;background:#ff1642;color:#fff;font-size:20px;cursor:pointer;box-shadow:0 0 20px #ff164255}.smallRound{border:0;background:none;color:#fff;font-size:20px;cursor:pointer}.volume{width:85px}
.heroButtons{display:flex;gap:10px;flex-wrap:wrap;margin-top:13px}.btn{border:1px solid #55555c;border-radius:20px;padding:9px 14px;background:#111217;color:#fff;font-weight:800;cursor:pointer}.btn.red{background:#ec153a;border-color:#ec153a}.btn.green{background:#141916;border-color:#226c3e;color:#56e684}
.queue{background:#0e0f12;border-left:1px solid #292a2e;padding:12px 14px 14px;overflow:auto}.queue h3{font-size:13px;margin:0 0 8px;letter-spacing:.4px}.nextOne,.qrow{display:grid;grid-template-columns:48px 1fr auto;gap:10px;align-items:center;padding:8px 0;border-bottom:1px solid #25262b}.nextOne img,.qrow img{width:48px;height:48px;border-radius:6px;object-fit:cover;background:#222}.qrow b,.nextOne b{font-size:13px}.qrow span,.nextOne span{font-size:11px;color:#b6b7bc}.qrow small{color:#ddd;font-size:11px}
.programStrip{display:grid;grid-template-columns:repeat(6,minmax(160px,1fr));gap:8px;padding:8px 2vw 14px;background:#0b0c0e;border-bottom:1px solid #35131c;overflow:auto}.programCard{min-width:180px;height:130px;border:1px solid #a00d26;border-radius:8px;overflow:hidden;position:relative;background:#17171a}.programCard img{width:100%;height:100%;object-fit:cover}.programCard .overlay{position:absolute;inset:0;background:linear-gradient(0deg,#08080a80,transparent 55%)}.programCard .corrected{position:absolute;left:10px;right:10px;bottom:8px;font-size:11px;font-weight:800;text-shadow:0 1px 4px #000}.programCard.hora:after{content:"Jay Gamboa + Aly Lardoeyt";position:absolute;left:10px;bottom:8px;background:#08080bc9;padding:5px 8px;border-radius:5px;font-size:11px;font-weight:900}
.section{padding:18px 2vw}.sectionHead{display:flex;align-items:center;gap:12px;margin-bottom:12px}.sectionHead h2{font-size:22px;margin:0}.sectionHead .accent{font-size:28px;color:#ff1642}.sectionHead .right{margin-left:auto;display:flex;gap:10px}.search{background:#101115;color:#fff;border:1px solid #33343a;border-radius:7px;padding:10px 12px;min-width:260px}
.artistRail{display:flex;gap:14px;overflow:auto;padding:2px 0 10px}.artistChip{min-width:88px;text-align:center;cursor:pointer}.artistChip img{width:76px;height:76px;border-radius:50%;object-fit:cover;border:2px solid #e51439;background:#222}.artistChip b{display:block;font-size:11px;margin-top:7px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.threeCols{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px}.panel{background:#101115;border:1px solid #24252a;border-radius:8px;overflow:hidden}.panelTitle{padding:10px 12px;border-bottom:1px solid #24252a;display:flex;justify-content:space-between;font-size:13px;font-weight:900}.newsGrid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;padding:10px}.newsItem{min-width:0}.newsItem .ph{height:96px;border-radius:5px;background:linear-gradient(145deg,#681123,#15161a);display:grid;place-items:center;font-weight:900;color:#f58ca0}.newsItem b{display:block;font-size:12px;margin-top:7px}.newsItem small{color:#81828a;font-size:10px}
.podcastRow,.chartRow{display:grid;grid-template-columns:78px 1fr auto;gap:10px;align-items:center;padding:8px 10px;border-bottom:1px solid #27282d}.podcastRow img{width:78px;height:45px;object-fit:cover;border-radius:4px}.podcastRow b,.chartRow b{font-size:12px}.podcastRow small,.chartRow small{display:block;color:#8f9097;font-size:10px;margin-top:3px}.playMini{width:32px;height:32px;border:2px solid #f0143c;border-radius:50%;display:grid;place-items:center;color:#f0143c}.rank{width:28px;height:28px;border-radius:6px;background:#30323a;display:grid;place-items:center;font-weight:900}.rank.one{background:#b47b10}
.contentGrid{display:grid;grid-template-columns:2fr 1fr;gap:12px;margin-top:12px}.chat{height:280px;padding:12px;overflow:auto}.chatMsg{padding:8px 0;border-bottom:1px solid #25262b}.chatMsg b{font-size:12px}.chatMsg p{font-size:12px;color:#b6b6bd;margin:4px 0}.chatForm{display:flex;gap:7px;padding:10px;border-top:1px solid #25262b}.chatForm input{flex:1;background:#0a0b0d;border:1px solid #34353a;color:#fff;padding:9px;border-radius:6px}
.footerPlayer{position:fixed;bottom:0;left:0;right:0;height:72px;background:#0b0c0ff4;border-top:2px solid #d41132;display:grid;grid-template-columns:minmax(220px,300px) 1fr minmax(260px,370px);align-items:center;padding:6px 2vw;z-index:70;backdrop-filter:blur(12px)}.miniTrack{display:grid;grid-template-columns:54px 1fr;gap:10px;align-items:center}.miniTrack img{width:54px;height:54px;border-radius:5px;object-fit:cover;background:#222}.miniTrack b{font-size:13px}.miniTrack span{display:block;color:#cacbd0;font-size:12px;margin-top:3px}.footerControls{display:flex;align-items:center;justify-content:center;gap:14px}.footerActions{display:flex;justify-content:flex-end;gap:8px;align-items:center}.footerActions a{padding:8px 10px;border:1px solid #33343a;border-radius:8px;font-size:11px}.footerActions .spotify{color:#56e684}
.artistModal{display:none;position:fixed;inset:0;background:#040507e8;z-index:100;padding:30px;overflow:auto}.artistModal.open{display:block}.artistPanel{max-width:850px;margin:auto;background:#111216;border:1px solid #33343a;border-radius:12px;overflow:hidden}.artistTop{display:grid;grid-template-columns:220px 1fr;gap:20px;padding:22px;background:linear-gradient(135deg,#3b0914,#111216)}.artistTop img{width:220px;height:220px;object-fit:cover;border-radius:9px;background:#222}.artistTop h2{font-size:35px;margin:5px 0}.artistSongs{padding:15px 20px}.songRow{display:grid;grid-template-columns:50px 1fr auto;gap:10px;padding:9px 0;border-bottom:1px solid #26272c;align-items:center}.songRow img{width:50px;height:50px;border-radius:5px;object-fit:cover}.close{position:absolute;right:35px;top:20px;background:#17181c;border:1px solid #555;color:#fff;width:38px;height:38px;border-radius:50%;font-size:20px}
@media(max-width:1000px){.nav{display:none}.liveHero{grid-template-columns:1fr}.queue{border-left:0;border-top:1px solid #292a2e}.threeCols{grid-template-columns:1fr}.footerPlayer{grid-template-columns:1fr auto}.footerControls{display:none}.footerActions{display:none}}
@media(max-width:720px){.heroMain{grid-template-columns:1fr;padding:0}.artistPortrait{height:260px;min-height:260px}.nowBox{padding:16px 18px 20px}.nowBox h1{font-size:32px}.programStrip{grid-template-columns:repeat(6,260px)}.contentGrid{grid-template-columns:1fr}.artistTop{grid-template-columns:1fr}.artistTop img{width:100%;height:auto;aspect-ratio:1}}
</style>
</head>
<body>
<header class="header">
  <a class="brand" href="#inicio"><img src="data:image/webp;base64," alt="Cadena Roja"><span>Cadena Roja</span></a>
  <nav class="nav">
    <a class="active" href="#inicio">⌂ Inicio</a><a href="#directo">((•)) En vivo</a><a href="#programacion">▦ Programación</a><a href="#artistas">♫ Artistas</a><a href="#top">▥ Top Semanal</a><a href="#podcasts">♩ Podcasts</a><a href="#noticias">▤ Noticias</a><a href="#videos">▶ Vídeos</a><a href="#comunidad">♣ Comunidad</a><a href="#promocion">⚑ Promoción</a><a href="#contacto">✉ Contacto</a>
  </nav>
  <span class="searchIcon">⌕</span>
</header>

<main id="inicio">
<section class="liveHero" id="directo">
  <div class="heroMain">
    <div class="artistPortrait">
      <img id="heroArtist" src="data:image/svg+xml;base64," alt="Artista actual">
      <div class="liveBadge">((•)) EN VIVO</div>
    </div>
    <div class="nowBox">
      <span class="nowLabel">AHORA SUENA</span>
      <h1 id="nowArtist">Cadena Roja</h1>
      <div class="song" id="nowTitle">Conectando con la emisión…</div>
      <div class="wave" aria-hidden="true"><i style="height:16px"></i><i style="height:34px"></i><i style="height:23px"></i><i style="height:45px"></i><i style="height:30px"></i><i style="height:52px"></i><i style="height:27px"></i><i style="height:40px"></i><i style="height:18px"></i><i style="height:48px"></i><i style="height:38px"></i><i style="height:55px"></i><i style="height:25px"></i><i style="height:42px"></i><i style="height:32px"></i><i style="height:51px"></i><i style="height:21px"></i><i style="height:37px"></i><i style="height:46px"></i><i style="height:28px"></i><i style="height:52px"></i><i style="height:35px"></i><i style="height:20px"></i><i style="height:43px"></i><i style="height:31px"></i><i style="height:49px"></i><i style="height:27px"></i><i style="height:41px"></i><i style="height:17px"></i><i style="height:36px"></i><i style="height:28px"></i><i style="height:46px"></i><i style="height:24px"></i><i style="height:39px"></i></div>
      <div class="progress"><b id="progress"></b></div>
      <div class="times"><span id="elapsed">0:00</span><span id="duration">--:--</span></div>
      <div class="controls">
        <button class="round" id="playMain" aria-label="Reproducir o pausar">▶</button>
        <span aria-hidden="true">🔊</span>
        <input class="volume" id="volume" type="range" min="0" max="1" step=".01" value=".85" aria-label="Volumen">
        <span><b id="listeners">—</b> oyentes</span>
      </div>
      <div class="heroButtons"><button class="btn red" id="voteCurrent">♥ Votar</button><button class="btn" id="requestCurrent">♫ Solicitar canción</button><a class="btn green" id="spotifyCurrent" target="_blank">● Abrir en Spotify</a></div>
    </div>
  </div>
  <aside class="queue">
    <h3>▣ A CONTINUACIÓN</h3>
    <div class="nextOne"><img id="nextArt" src="data:image/svg+xml;base64,"><div><b id="nextTitle">Esperando cola…</b><span id="nextArtist">Cadena Roja</span></div><small id="nextDur"></small></div>
    <h3 style="margin-top:12px">PRÓXIMAS CANCIONES</h3>
    <div id="queueList"></div>
  </aside>
</section>

<section class="programStrip" id="programacion">
  <article class="programCard hora"><img src="data:image/webp;base64," alt="La Hora Roja"><span class="overlay"></span></article>
  <article class="programCard"><img src="data:image/webp;base64," alt="Tu Voz Anónima"></article>
  <article class="programCard"><img src="data:image/webp;base64," alt="Misterios y Sucesos"></article>
  <article class="programCard"><img src="data:image/webp;base64," alt="Vida y Obra"></article>
  <article class="programCard"><img src="data:image/webp;base64," alt="Top Semanal"></article>
  <article class="programCard" id="promocion"><img src="data:image/webp;base64," alt="Promoción para artistas"></article>
</section>

<section class="section" id="artistas">
  <div class="sectionHead"><span class="accent">♫</span><h2>ARTISTAS EN CADENA ROJA</h2><span id="artistCount" style="color:#aaa;font-size:12px">0 artistas</span><div class="right"><input id="artistSearch" class="search" placeholder="⌕ Buscar artista o canción…"></div></div>
  <div class="artistRail" id="artistRail"></div>
</section>

<section class="section threeCols">
  <article class="panel" id="noticias">
    <div class="panelTitle"><span>♨ ÚLTIMAS NOTICIAS</span><span>Ver todas →</span></div>
    <div class="newsGrid">
      <div class="newsItem"><div class="ph">FARÁNDULA</div><b>Noticias y actualidad de los artistas</b><small>Próximamente</small></div>
      <div class="newsItem"><div class="ph">ESTRENOS</div><b>Nuevos lanzamientos y videoclips</b><small>Próximamente</small></div>
      <div class="newsItem"><div class="ph">ENTREVISTAS</div><b>Conversaciones con artistas</b><small>Próximamente</small></div>
    </div>
  </article>
  <article class="panel" id="podcasts">
    <div class="panelTitle"><span>◉ PODCASTS DESTACADOS</span><span>Ver todos →</span></div>
    <div class="podcastRow"><img src="data:image/webp;base64,"><div><b>La Hora Roja</b><small>Jay Gamboa + Aly Lardoeyt · farándula, entrevistas y actualidad</small></div><span class="playMini">▶</span></div>
    <div class="podcastRow"><img src="data:image/webp;base64,"><div><b>Misterios y Sucesos</b><small>Historias, psicología y casos sin resolver</small></div><span class="playMini">▶</span></div>
    <div class="podcastRow"><img src="data:image/webp;base64,"><div><b>Vida y Obra</b><small>Trayectoria de artistas cubanos e internacionales</small></div><span class="playMini">▶</span></div>
  </article>
  <article class="panel" id="top">
    <div class="panelTitle"><span>▣ TOP SEMANAL</span><span>Ver todos →</span></div>
    <div id="chartList"><div class="chartRow"><span class="rank one">1</span><div><b>El chart se cargará con la emisión</b><small>votos + solicitudes + emisiones</small></div><span>—</span></div></div>
  </article>
</section>

<section class="section contentGrid" id="comunidad">
  <article class="panel">
    <div class="panelTitle"><span>COMUNIDAD EN VIVO</span><span>Chat de oyentes</span></div>
    <div class="chat" id="chatFeed"><div class="chatMsg"><b>Cadena Roja</b><p>Bienvenidos al chat. En Oracle este espacio se conectará a todos los oyentes en tiempo real.</p></div></div>
    <form class="chatForm" id="chatForm"><input id="chatName" placeholder="Tu nombre"><input id="chatText" placeholder="Escribe un mensaje…"><button class="btn red">Enviar</button></form>
  </article>
  <article class="panel">
    <div class="panelTitle"><span>TU VOZ ANÓNIMA</span><span>La Hora Roja</span></div>
    <div style="padding:14px"><p style="color:#bbb;font-size:13px">Envía una historia o problema de forma anónima para debatirlo en el programa.</p><textarea id="anonText" style="width:100%;height:120px;background:#0a0b0d;color:#fff;border:1px solid #333;border-radius:7px;padding:10px" placeholder="Cuéntanos tu historia…"></textarea><button class="btn red" id="anonSend" style="margin-top:8px">Enviar anónimamente</button></div>
  </article>
</section>
</main>

<div class="artistModal" id="artistModal"><button class="close" id="artistClose">×</button><div class="artistPanel"><div class="artistTop"><img id="profilePhoto" src="data:image/svg+xml;base64,"><div><small style="color:#ff3156;font-weight:900">ARTISTA EN CADENA ROJA</small><h2 id="profileName">Artista</h2><p id="profileMeta" style="color:#aaa"></p><a class="btn green" id="profileSpotify" target="_blank">Spotify ↗</a></div></div><div class="artistSongs"><h3>Canciones en Cadena Roja</h3><div id="profileSongs"></div></div></div></div>

<footer class="footerPlayer">
  <audio id="audio" preload="none"></audio>
  <div class="miniTrack"><img id="miniArt" src="data:image/svg+xml;base64,"><div><b id="miniArtist">Cadena Roja</b><span id="miniTitle">En directo</span></div></div>
  <div class="footerControls">
    <button class="round" id="playFooter" aria-label="Reproducir o pausar">▶</button>
    <span aria-hidden="true">🔊</span>
    <input class="volume" id="volumeFooter" type="range" min="0" max="1" step=".01" value=".85" aria-label="Volumen">
    <span id="footerTime" style="font-size:12px;color:#bbb">0:00 / --:--</span>
  </div>
  <div class="footerActions"><a id="footerSpotify" class="spotify" target="_blank">Spotify</a><a target="_blank">YouTube</a><a target="_blank">Apple Music</a></div>
</footer>

<script>
const CFG={
  stream:'/radio-stream',
  now:'/radio-nowplaying',
  artistPlaceholder:"data:image/svg+xml;base64,"
};
const $=s=>document.querySelector(s), audio=$('#audio'); audio.src=CFG.stream; audio.volume=.85;
let state={np:null,artists:new Map(Object.entries(JSON.parse(localStorage.getItem('cr_artist_catalog')||'{}'))),votes:JSON.parse(localStorage.getItem('cr_votes')||'{}'),requests:JSON.parse(localStorage.getItem('cr_requests')||'{}')};
const norm=s=>(s||'').trim().toLowerCase(), key=(a,t)=>norm(a)+'||'+norm(t), fmt=x=>{x=Math.max(0,Math.floor(+x||0));return Math.floor(x/60)+':'+String(x%60).padStart(2,'0')};
function normalizeAzuraUrl(url){
  if(!url) return '';
  return String(url)
    .replace('http://82.70.88.49/','/azura/')
    .replace('https://82.70.88.49/','/azura/');
}
function safeImg(el,url){
  const fixed=normalizeAzuraUrl(url);
  el.src=fixed||CFG.artistPlaceholder;
  el.onerror=()=>{el.src=CFG.artistPlaceholder};
}
function spotify(a,t=''){return 'https://open.spotify.com/search/'+encodeURIComponent((a+' '+t).trim())}
function remember(song){if(!song?.artist)return;const k=norm(song.artist),p=state.artists.get(k)||{name:song.artist,art:'',songs:[]};if(song.art)p.art=song.art;const title=(song.title||song.text||'').trim();if(title&&!p.songs.some(x=>norm(x.title)===norm(title)))p.songs.push({title,art:song.art||'',duration:song.duration||0});state.artists.set(k,p);localStorage.setItem('cr_artist_catalog',JSON.stringify(Object.fromEntries(state.artists)))}
async function toggle(){try{audio.paused?await audio.play():audio.pause()}catch(e){} syncPlay()}
function syncPlay(){let v=audio.paused?'▶':'❚❚';$('#playMain').textContent=v;$('#playFooter').textContent=v}
$('#playMain').onclick=toggle;$('#playFooter').onclick=toggle;audio.onplay=syncPlay;audio.onpause=syncPlay;
const volumeTop=$('#volume'), volumeBottom=$('#volumeFooter');
function setVolume(v){
  const n=Math.max(0,Math.min(1,Number(v)));
  audio.volume=n;
  if(volumeTop) volumeTop.value=n;
  if(volumeBottom) volumeBottom.value=n;
  localStorage.setItem('cr_volume',String(n));
}
const savedVolume=localStorage.getItem('cr_volume');
if(savedVolume!==null) setVolume(savedVolume); else setVolume(.85);
if(volumeTop) volumeTop.oninput=e=>setVolume(e.target.value);
if(volumeBottom) volumeBottom.oninput=e=>setVolume(e.target.value);

function renderNow(j){state.np=j;const n=j.now_playing||{},s=n.song||{},a=s.artist||'Cadena Roja',t=s.title||s.text||'En directo',art=s.art||'';
$('#nowArtist').textContent=a;$('#nowTitle').textContent=t;$('#miniArtist').textContent=a;$('#miniTitle').textContent=t;safeImg($('#heroArtist'),art);safeImg($('#miniArt'),art);$('#listeners').textContent=j.listeners?.current??j.listeners?.unique??'—';$('#spotifyCurrent').href=spotify(a,t);$('#footerSpotify').href=spotify(a,t);
remember(s);(j.song_history||[]).forEach(h=>remember(h.song||{}));renderArtists();renderQueue(j);renderChart();}
function renderQueue(j){const n=j.playing_next||null,s=n?.song||n||null;if(s){$('#nextTitle').textContent=s.title||s.text||'Próximo tema';$('#nextArtist').textContent=s.artist||'Artista';$('#nextDur').textContent=s.duration?fmt(s.duration):'';safeImg($('#nextArt'),s.art||'');}
const list=$('#queueList'); list.innerHTML=''; const hist=(j.song_history||[]).slice(0,5); if(!hist.length){list.innerHTML='<div style="color:#777;font-size:11px;padding:12px 0">La cola completa aparecerá al conectar el backend privado de Oracle.</div>';return} hist.forEach((h,i)=>{const s=h.song||{},r=document.createElement('div');r.className='qrow';r.innerHTML='<img><div><b></b><span></span></div><small></small>';safeImg(r.querySelector('img'),s.art||'');r.querySelector('b').textContent=s.artist||'Artista';r.querySelector('span').textContent=s.title||s.text||'Tema';r.querySelector('small').textContent=h.duration?fmt(h.duration):'';list.appendChild(r)})}
function renderArtists(){const q=norm($('#artistSearch').value),arr=[...state.artists.values()].filter(a=>!q||norm(a.name+' '+(a.songs||[]).map(s=>s.title).join(' ')).includes(q)).sort((a,b)=>a.name.localeCompare(b.name,'es'));$('#artistCount').textContent=arr.length+' artistas';const root=$('#artistRail');root.innerHTML=''; if(!arr.length){for(let i=0;i<10;i++){const d=document.createElement('div');d.className='artistChip';d.innerHTML='<img><b>Esperando artistas</b>';safeImg(d.querySelector('img'),'');root.appendChild(d)}return}arr.forEach(a=>{const c=document.createElement('div');c.className='artistChip';c.innerHTML='<img><b></b>';safeImg(c.querySelector('img'),a.art);c.querySelector('b').textContent=a.name;c.onclick=()=>openArtist(a.name);root.appendChild(c)})}
async function openArtist(name){const a=state.artists.get(norm(name));if(!a)return;$('#profileName').textContent=a.name;safeImg($('#profilePhoto'),a.art);$('#profileMeta').textContent=(a.songs||[]).length+' canciones registradas';$('#profileSpotify').href=spotify(a.name);const root=$('#profileSongs');root.innerHTML='';(a.songs||[]).sort((x,y)=>x.title.localeCompare(y.title,'es')).forEach(s=>{const r=document.createElement('div');r.className='songRow';r.innerHTML='<img><div><b></b><small></small></div><a target="_blank">Spotify ↗</a>';safeImg(r.querySelector('img'),s.art||a.art);r.querySelector('b').textContent=s.title;r.querySelector('small').textContent=s.duration?fmt(s.duration):'Cadena Roja';r.querySelector('a').href=spotify(a.name,s.title);root.appendChild(r)});$('#artistModal').classList.add('open')}
$('#artistClose').onclick=()=>$('#artistModal').classList.remove('open');$('#artistModal').onclick=e=>{if(e.target.id==='artistModal')$('#artistModal').classList.remove('open')};$('#artistSearch').oninput=renderArtists;
function renderChart(){const plays=new Map();if(state.np?.now_playing){const s=state.np.now_playing.song||{};if(s.artist)plays.set(key(s.artist,s.title||s.text),{artist:s.artist,title:s.title||s.text,art:s.art,plays:1})}(state.np?.song_history||[]).forEach(h=>{const s=h.song||{},k=key(s.artist,s.title||s.text);if(!s.artist)return;let o=plays.get(k)||{artist:s.artist,title:s.title||s.text,art:s.art,plays:0};o.plays++;plays.set(k,o)});Object.entries(state.votes).forEach(([k,v])=>{let o=plays.get(k);if(o)o.votes=v});Object.entries(state.requests).forEach(([k,v])=>{let o=plays.get(k);if(o)o.requests=v});const arr=[...plays.values()].map(o=>({...o,score:o.plays*2+(o.votes||0)*4+(o.requests||0)*3})).sort((a,b)=>b.score-a.score).slice(0,5);const root=$('#chartList');root.innerHTML='';arr.forEach((o,i)=>{const r=document.createElement('div');r.className='chartRow';r.innerHTML='<span class="rank"></span><div><b></b><small></small></div><span></span>';r.querySelector('.rank').textContent=i+1;if(i===0)r.querySelector('.rank').classList.add('one');r.querySelector('b').textContent=o.title+' - '+o.artist;r.querySelector('small').textContent=(o.votes||0)+' votos · '+(o.requests||0)+' solicitudes';r.lastElementChild.textContent=o.score;root.appendChild(r)})}
function voteCurrent(){const j=state.np,s=j?.now_playing?.song;if(!s)return;const k=key(s.artist,s.title||s.text);state.votes[k]=(state.votes[k]||0)+1;localStorage.setItem('cr_votes',JSON.stringify(state.votes));renderChart()}
function requestCurrent(){const j=state.np,s=j?.now_playing?.song;if(!s)return;const k=key(s.artist,s.title||s.text);state.requests[k]=(state.requests[k]||0)+1;localStorage.setItem('cr_requests',JSON.stringify(state.requests));renderChart()}
$('#voteCurrent').onclick=voteCurrent;$('#requestCurrent').onclick=requestCurrent;
function tick(){const n=state.np?.now_playing;if(!n)return;const d=+n.duration||0,e=Math.max(0,Math.min(d||1,(Date.now()/1000)-(n.played_at||Date.now()/1000)));$('#elapsed').textContent=fmt(e);$('#duration').textContent=d?fmt(d):'EN VIVO';$('#progress').style.width=d?Math.min(100,e/d*100)+'%':'0%';$('#footerTime').textContent=fmt(e)+' / '+(d?fmt(d):'EN VIVO')}
async function load(){try{const r=await fetch(CFG.now,{cache:'no-store'});if(r.ok)renderNow(await r.json())}catch(e){}}
$('#chatForm').onsubmit=e=>{e.preventDefault();const n=$('#chatName').value.trim()||'Oyente',m=$('#chatText').value.trim();if(!m)return;const d=document.createElement('div');d.className='chatMsg';d.innerHTML='<b></b><p></p>';d.querySelector('b').textContent=n;d.querySelector('p').textContent=m;$('#chatFeed').appendChild(d);$('#chatText').value=''};
$('#anonSend').onclick=()=>{$('#anonText').value='';alert('En la versión de Oracle se enviará de forma privada al equipo de Cadena Roja.')};
renderArtists();load();setInterval(load,15000);setInterval(tick,1000);
</script>
</body>
</html>